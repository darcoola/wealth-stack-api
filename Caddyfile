# Single public hostname. Caddy obtains and renews a Let's Encrypt certificate for it
# automatically (HTTP-01 challenge on :80) and redirects http → https.
#
# Keycloak lives under /auth on the same host, which keeps the deployment to one DNS name and one
# certificate. It matches KC_HTTP_RELATIVE_PATH=/auth, so the prefix is passed through as-is
# (`handle`, not `handle_path` — Keycloak expects to see /auth in the path).

{$APP_HOST} {
	encode zstd gzip

	handle /auth/* {
		reverse_proxy keycloak:8081
	}

	handle {
		reverse_proxy app:8088
	}
}
