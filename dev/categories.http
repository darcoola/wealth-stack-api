### List all categories
GET http://localhost:8088/api/v1/categories

### Create a category (groupId optional; omit or null = Ungrouped)
POST http://localhost:8088/api/v1/categories
Content-Type: application/json

{ "name": "Groceries", "groupId": 1 }

### Create the Spending / Income / Others groups (only needed on an empty installation — a group that already exists is rejected)
POST http://localhost:8088/api/v1/category-groups
Content-Type: application/json

{ "name": "Spending" }

###
POST http://localhost:8088/api/v1/category-groups
Content-Type: application/json

{ "name": "Income" }

###
POST http://localhost:8088/api/v1/category-groups
Content-Type: application/json

{ "name": "Others" }

### Look up the group ids by name (run this before the batch below — it fills {{spendingGroupId}} etc.)
GET http://localhost:8088/api/v1/category-groups

> {%
    const groups = response.body;
    [["Spending", "spendingGroupId"], ["Income", "incomeGroupId"], ["Others", "othersGroupId"]].forEach(([name, variable]) => {
        const group = groups.find(g => g.name === name);
        if (group) {
            client.global.set(variable, group.id);
        } else {
            client.log(`No group named '${name}' — create it first`);
        }
    });
%}

### Create multiple categories (run the group lookup above first)
POST http://localhost:8088/api/v1/categories/batch
Content-Type: application/json

[
  { "name": "Dom", "groupId": {{spendingGroupId}} },
  { "name": "Dzieci", "groupId": {{spendingGroupId}} },
  { "name": "Dieta (Maczfit)", "groupId": {{spendingGroupId}} },
  { "name": "Edukacja", "groupId": {{spendingGroupId}} },
  { "name": "Firma Darek", "groupId": {{incomeGroupId}} },
  { "name": "Firma Kasia", "groupId": {{incomeGroupId}} },
  { "name": "Inwestycje", "groupId": {{othersGroupId}} },
  { "name": "Jedzenie/Restauracje", "groupId": {{spendingGroupId}} },
  { "name": "Mieszkania BemoVita", "groupId": {{othersGroupId}} },
  { "name": "Mieszkanie Metro Zachód", "groupId": {{othersGroupId}} },
  { "name": "Odzież", "groupId": {{spendingGroupId}} },
  { "name": "Oprocentowanie / Cashback", "groupId": {{othersGroupId}} },
  { "name": "Paliwo", "groupId": {{spendingGroupId}} },
  { "name": "Podatki Darek", "groupId": {{incomeGroupId}} },
  { "name": "Podatki Kasia", "groupId": {{incomeGroupId}} },
  { "name": "Podróże", "groupId": {{spendingGroupId}} },
  { "name": "Pożyczka", "groupId": {{othersGroupId}} },
  { "name": "Prezenty i Rozrywka", "groupId": {{spendingGroupId}} },
