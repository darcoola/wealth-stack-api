{
  "realm": "wealthstack",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "loginTheme": "keycloak",
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "wealthstack-user",
        "description": "Approved wealth-stack user. Assign manually to let a signed-up user into the app."
      }
    ]
  },
  "clients": [
    {
      "clientId": "wealthstack-web",
      "name": "wealth-stack SPA",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "rootUrl": "http://localhost:8088",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:8088/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:8088/*"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email"
      }
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "email": "dev@wealthstack.local",
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["wealthstack-user", "default-roles-wealthstack"]
    }
  ]
}
