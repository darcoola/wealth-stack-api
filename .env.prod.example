# Copy to `.env.prod` on the server and fill in. `.env.prod` is gitignored — never commit it.
#
#   cp .env.prod.example .env.prod && nano .env.prod
#   docker compose -f compose.prod.yml --env-file .env.prod up -d --build

# Public hostname. With sslip.io you need no DNS registrar at all: the hostname encodes the IP.
# For public IP 130.61.42.7 use 130-61-42-7.sslip.io (dashes, not dots).
# Caddy issues a real Let's Encrypt certificate for it. Swap in a real domain later by changing
# this one line (plus the Keycloak client redirect URIs and the Google console entry).
APP_HOST=130-61-42-7.sslip.io

# Your Google account email. The FIRST login with this address adopts the bootstrap party (id 1)
# and everything imported before multi-user support. Get this right before the first sign-in.
WEALTHSTACK_OWNER_EMAIL=dariuszkulig@gmail.com

# Generate each of these with:  openssl rand -base64 24
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

KEYCLOAK_ADMIN_USER=admin

# Google OAuth client (see DEPLOY.md step 7). Until these are real, the "Sign in with Google"
# button appears but fails; the local `dev` Keycloak user still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
